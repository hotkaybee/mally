# =====================================================================
# 1. ОСНОВНЫЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ (Mally Store)
# =====================================================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

VITE_APP_NAME="${APP_NAME}"

# =====================================================================
# 2. ЛОГИРОВАНИЕ И ХРАНИЛИЩЕ
# =====================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =====================================================================
# 3. БАЗА ДАННЫХ, СЕССИИ И КЭШ
# =====================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mally
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =====================================================================
# 4. ПОЧТА (коды регистрации и сброса пароля)
# =====================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =====================================================================
# 5. TELEGRAM — БОТ АДМИНИСТРАТОРА (уведомления о заказах и заявках)
# =====================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_ADMIN_USERNAME=mallyuz

# =====================================================================
# 6. TELEGRAM — БОТ ВЕРИФИКАЦИИ И ВХОДА ПОКУПАТЕЛЕЙ
# =====================================================================
# Отдельный бот, не тот, что в разделе 5.
# Без webhook-секрета запустите `php artisan telegram:auth-poll`
# (локально бот также опрашивается сам, пока открыто окно входа).
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_BOT_USERNAME=
TELEGRAM_AUTH_WEBHOOK_SECRET=

# =====================================================================
# 7. GOOGLE — ВХОД И РЕГИСТРАЦИЯ «ПРОДОЛЖИТЬ С GOOGLE»
# =====================================================================
# Google Cloud Console → Google Auth Platform → Clients → OAuth client,
# тип «Web application». Authorised redirect URI: <APP_URL>/auth/google/callback
# После изменения выполните: php artisan optimize:clear
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Необязательно: по умолчанию APP_URL + /auth/google/callback.
# GOOGLE_REDIRECT_URI=

# =====================================================================
# 8. ОПЛАТА — РЕКВИЗИТЫ МАГАЗИНА (показываются в чеке заказа)
# =====================================================================
STORE_CARD_NUMBER=
STORE_CARD_HOLDER=
STORE_PROMO_CODE=
STORE_PROMO_PERCENT=0
