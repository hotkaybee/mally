# =====================================================================
# 1. ОСНОВНЫЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ (Mally Store)
# =====================================================================
APP_NAME=Mally
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://<domain>
# (https also makes the session cookie Secure).

# Reverse proxies whose X-Forwarded-* headers are trusted (the host nginx in
# front of Docker). Never "*" while the app port is reachable from outside.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"

# =====================================================================
# 2. ЛОГИРОВАНИЕ И ХРАНИЛИЩЕ
# =====================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_STACK=daily, LOG_DAILY_DAYS=14, LOG_LEVEL=warning
FILESYSTEM_DISK=local

# =====================================================================
# 3. БАЗА ДАННЫХ, СЕССИИ И КЭШ (SQLite)
# =====================================================================
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# MySQL (production / Docker):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=mally
# DB_USERNAME=mally
# DB_PASSWORD=
# DB_ROOT_PASSWORD=          # docker-compose.prod.yml (MySQL container)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# Admin-bot and contact-form messages are queued; `composer dev` and the
# Docker supervisor run a worker.
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# =====================================================================
# 4. ПОЧТА (Gmail SMTP — отправка кодов регистрации и сброса пароля)
# =====================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="your-email@gmail.com"
MAIL_PASSWORD="your-16-char-app-password"
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="Mally"
# In production MAIL_MAILER=log is refused: it would write login codes to the log.

# =====================================================================
# 5. TELEGRAM — БОТ АДМИНИСТРАТОРА (Уведомления о заказах и заявках)
# =====================================================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_IDS=""
TELEGRAM_BOT_USERNAME="MallyAdmin_bot"
TELEGRAM_ADMIN_USERNAME="mallyuz"

# =====================================================================
# 6. TELEGRAM — БОТ ВЕРИФИКАЦИИ И ВХОДА ПОКУПАТЕЛЕЙ
# =====================================================================
TELEGRAM_AUTH_BOT_TOKEN=""
TELEGRAM_AUTH_BOT_USERNAME="mally_uz_bot"
# Secret for Telegram webhook updates (X-Telegram-Bot-Api-Secret-Token).
# Empty = no webhook; updates are fetched by `php artisan telegram:auth-poll`.
TELEGRAM_AUTH_WEBHOOK_SECRET=""

# =====================================================================
# 7. МАГАЗИН — реквизиты на странице чека, промокод, API для бота
# =====================================================================
STORE_CARD_NUMBER=""
STORE_CARD_HOLDER=""
# One promo code; empty = no promo code.
STORE_PROMO_CODE=""
STORE_PROMO_PERCENT=0
# Secret for POST /api/orders (X-Api-Token header); empty = endpoint disabled
ORDERS_API_TOKEN=""

# =====================================================================
# 8. DOCKER (docker-compose.prod.yml / entrypoint)
# =====================================================================
# APP_IMAGE=ghcr.io/hotkaybee/mally:latest
# APP_BIND=127.0.0.1         # only the host reverse proxy reaches the app
# APP_PORT=8080
# RUN_MIGRATIONS=true
# RUN_SEEDERS=false          # catalog seeders refuse to run on a shop with data
