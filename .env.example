# =====================================================================
# 1. ОСНОВНЫЕ НАСТРОЙКИ ПРИЛОЖЕНИЯ (Mally Store)
# =====================================================================
APP_NAME=Mally
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"

# =====================================================================
# 2. ЛОГИРОВАНИЕ И ХРАНИЛИЩЕ
# =====================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
FILESYSTEM_DISK=local

# =====================================================================
# 3. БАЗА ДАННЫХ, СЕССИИ И КЭШ (SQLite)
# =====================================================================
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# =====================================================================
# 4. ПОЧТА (Gmail SMTP — отправка кодов регистрации и сброса пароля)
# =====================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="your-email@gmail.com"
MAIL_PASSWORD="your-16-char-app-password"
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="Mally"

# =====================================================================
# 5. TELEGRAM — БОТ АДМИНИСТРАТОРА (Уведомления о заказах и заявках)
# =====================================================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_IDS=""
TELEGRAM_BOT_USERNAME="MallyAdmin_bot"
TELEGRAM_ADMIN_USERNAME="mallyuz"

# =====================================================================
# 6. TELEGRAM — БОТ ВЕРИФИКАЦИИ И ВХОДА ПОКУПАТЕЛЕЙ
# =====================================================================
TELEGRAM_AUTH_BOT_TOKEN=""
TELEGRAM_AUTH_BOT_USERNAME="mally_uz_bot"
